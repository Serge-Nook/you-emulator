#. Plugin Name of the plugin
#: you-emulator.php
msgid "You Emulator"
msgstr "You Emulator"

#. Plugin URI of the plugin
#: you-emulator.php
msgid "https://github.com/Serge-Nook/you-emulator"
msgstr "https://github.com/Serge-Nook/you-emulator"

#. Description of the plugin
#: you-emulator.php
msgid ""
"Retro game library for WordPress powered by EmulatorJS: NES, SNES, Sega "
"Genesis, GBA, PlayStation, PSP and N64 right in the browser, with server-"
"side save states, hotkeys and gamepad combos."
msgstr ""
"Библиотека ретро-игр для WordPress на базе EmulatorJS: NES, SNES, Sega "
"Genesis, GBA, PlayStation, PSP и N64 прямо в браузере, с сохранениями на "
"сервере, горячими клавишами и комбинациями геймпада."

#. Author of the plugin
#: you-emulator.php
msgid "Горшков Сергей Владимирович"
msgstr "Горшков Сергей Владимирович"

